        esac
    fi

    # zotero-mcp-server: re-apply the hybrid search (BM25 + RRF) patch (idempotent).
    # Adds the sparse leg: Okapi BM25 index over the same ChromaDB chunks, fused
    # with the dense ranking via Reciprocal Rank Fusion (k=60) before the
    # cross-encoder reranker. Rebuilt automatically on each update-db. Marker:
    # [sparse patch]. See Zotero-MCP.md and New-RAG-Setup.md.
    echo -e "\033[36m  Re-applying zotero-mcp hybrid search patch...\033[0m"
    ZMPKG=$(find "$HOME/.local/share/uv/tools/zotero-mcp-server/lib" -type d -name zotero_mcp 2>/dev/null | head -1)
    ZHPATCH=/usr/share/turquoise/zotero-mcp-sparse-patch.py
    [[ -f "$ZHPATCH" ]] || ZHPATCH="$HOME/turquoise/files/system/usr/share/turquoise/zotero-mcp-sparse-patch.py"
    if [[ -z "$ZMPKG" ]]; then
        echo -e "  \033[33mzotero-mcp-server not installed — skipping hybrid patch.\033[0m"
    elif [[ ! -f "$ZHPATCH" ]]; then
        echo -e "  \033[33mzotero-mcp-sparse-patch.py not found; review manually.\033[0m"
    else
