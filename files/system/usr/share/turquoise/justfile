            mismatch*) echo -e "  \033[33mWARNING: contextual patch pattern changed upstream; not applied — review manually.\033[0m" ;;
            *) echo -e "  \033[33mContextual patch failed; review manually.\033[0m" ;;
        esac
    fi

    # zotero-mcp-server: re-apply the retrieval-hygiene filters patch (idempotent).
    # Four components, zero re-embed (BM25 rebuilds in ~2s; dense untouched):
    #  1. reference-chunk classifier (DCR breadcrumb + author-year density)
    #  2. exclude reference chunks from the BM25 leg (lexical noise killer;
    #     dense keeps them so citation queries still work)
    #  3. optional rerank-score floor (semantic_search.hybrid.rerank_floor)
    #  4. figure queries: inject [Figure Schema] chunks via a "Figure Schema"
    #     BM25 probe + boost their rerank score (semantic_search.hybrid.figure_boost)
    # Marker: [hybrid filter patch]. See Zotero-MCP.md and New-RAG-Setup.md.
    echo -e "\033[36m  Re-applying zotero-mcp retrieval-hygiene filters patch...\033[0m"
    ZMPKG=$(find "$HOME/.local/share/uv/tools/zotero-mcp-server/lib" -type d -name zotero_mcp 2>/dev/null | head -1)
    ZFPATCH=/usr/share/turquoise/zotero-mcp-hybrid-filter-patch.py
    [[ -f "$ZFPATCH" ]] || ZFPATCH="$HOME/turquoise/files/system/usr/share/turquoise/zotero-mcp-hybrid-filter-patch.py"
    if [[ -z "$ZMPKG" ]]; then
        echo -e "  \033[33mzotero-mcp-server not installed — skipping hybrid-filter patch.\033[0m"
    elif [[ ! -f "$ZFPATCH" ]]; then
        echo -e "  \033[33mzotero-mcp-hybrid-filter-patch.py not found; review manually.\033[0m"
    else
