        esac
    fi

    # zotero-mcp-server: re-apply the collection-scoped semantic search patch (idempotent).
    # Adds a `collection` param to zotero_semantic_search: chunk metadata stores each
    # item's collection keys and the search filters DB-side (ChromaDB where clause,
    # subcollections included). Backfill is metadata-only (no re-embed). Marker:
    # [scoped patch]. See Zotero-MCP.md and New-RAG-Setup.md.
    echo -e "\033[36m  Re-applying zotero-mcp collection-scoped search patch...\033[0m"
    ZMPKG=$(find "$HOME/.local/share/uv/tools/zotero-mcp-server/lib" -type d -name zotero_mcp 2>/dev/null | head -1)
    ZSPATCH=/usr/share/turquoise/zotero-mcp-scoped-patch.py
    [[ -f "$ZSPATCH" ]] || ZSPATCH="$HOME/turquoise/files/system/usr/share/turquoise/zotero-mcp-scoped-patch.py"
    if [[ -z "$ZMPKG" ]]; then
        echo -e "  \033[33mzotero-mcp-server not installed — skipping scoped patch.\033[0m"
    elif [[ ! -f "$ZSPATCH" ]]; then
