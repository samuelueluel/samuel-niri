            applied) systemctl --user restart zotero-mcp.service 2>/dev/null || true; echo -e "  \033[32mMinerU patch applied + zotero-mcp.service restarted.\033[0m" ;;
            already) echo -e "  Already patched." ;;
            mismatch*) echo -e "  \033[33mWARNING: mineru patch pattern changed upstream; not applied — review manually.\033[0m" ;;
            *) echo -e "  \033[33mMinerU patch failed; review manually.\033[0m" ;;
        esac
    fi

    # zotero-mcp-server: re-apply the HTTP reranker patch (idempotent).
    # Adds HttpCrossEncoderReranker to semantic_search.py: reranking delegates to
