            already) echo -e "  Already patched." ;;
            mismatch*) echo -e "  \033[33mWARNING: ast chunker patch pattern changed upstream; not applied — review manually.\033[0m" ;;
            *) echo -e "  \033[33mAST chunker patch failed; review manually.\033[0m" ;;
        esac
    fi

    # zotero-mcp-server: re-apply the date-filter patch (idempotent).
    # advanced_search date range ops (isAfter/isBefore/isGreaterThan/isLessThan)
    # fell back to raw Python string comparison whenever float() could not parse
    # BOTH sides — and Zotero's month-first display dates ("5/2018", "08/2024")
    # never parse as floats. On a library where ~46% of dated items are
    # month-first, every date-range query mis-ordered them in BOTH directions
    # (isAfter "2020" returned papers from 1981, excluded a real 2024 paper),
    # and no-date items vacuously matched isBefore. The patch adds a date-aware
    # comparison layer to tools/search.py (_parse_date + _compare date branch)
    # and fixes the `year` field extractor (date[:4] turned "5/2018" into
    # "5/20"). Marker: [date patch]. See Zotero-MCP.md (Date filters).
    echo -e "\033[36m  Re-applying zotero-mcp date-filter patch...\033[0m"
    ZMPKG=$(find "$HOME/.local/share/uv/tools/zotero-mcp-server/lib" -type d -name zotero_mcp 2>/dev/null | head -1)
    ZDPATCH=/usr/share/turquoise/zotero-mcp-date-patch.py
    [[ -f "$ZDPATCH" ]] || ZDPATCH="$HOME/turquoise/files/system/usr/share/turquoise/zotero-mcp-date-patch.py"
    if [[ -z "$ZMPKG" ]]; then
        echo -e "  \033[33mzotero-mcp-server not installed — skipping date patch.\033[0m"
    elif [[ ! -f "$ZDPATCH" ]]; then
        echo -e "  \033[33mzotero-mcp-date-patch.py not found; review manually.\033[0m"
    else
        case "$(python3 "$ZDPATCH" "$ZMPKG" 2>/dev/null || echo error)" in
            applied) systemctl --user restart zotero-mcp.service 2>/dev/null || true; echo -e "  \033[32mDate-filter patch applied + zotero-mcp.service restarted.\033[0m" ;;
            already) echo -e "  Already patched." ;;
            mismatch*) echo -e "  \033[33mWARNING: date patch pattern changed upstream; not applied — review manually.\033[0m" ;;
            *) echo -e "  \033[33mDate patch failed; review manually.\033[0m" ;;
        esac
    fi

    # zotero-mcp-server: re-apply the Deterministic Citation Graph patch (idempotent).
    # Builds an in-memory NetworkX directed graph over Zotero metadata and MinerU
    # bibliography sidecars ([REF]) to provide collection hub detection, paper
    # lineage tracking, and bibliographic coupling tools. Marker: [graph patch].
    echo -e "\033[36m  Re-applying zotero-mcp Deterministic Citation Graph patch...\033[0m"
    ZMPKG=$(find "$HOME/.local/share/uv/tools/zotero-mcp-server/lib" -type d -name zotero_mcp 2>/dev/null | head -1)
    ZGPATCH=/usr/share/turquoise/zotero-mcp-graph-patch.py
    [[ -f "$ZGPATCH" ]] || ZGPATCH="$HOME/turquoise/files/system/usr/share/turquoise/zotero-mcp-graph-patch.py"
    if [[ -z "$ZMPKG" ]]; then
        echo -e "  \033[33mzotero-mcp-server not installed — skipping graph patch.\033[0m"
    elif [[ ! -f "$ZGPATCH" ]]; then
        echo -e "  \033[33mzotero-mcp-graph-patch.py not found; review manually.\033[0m"
    else
        case "$(python3 "$ZGPATCH" "$ZMPKG" 2>/dev/null || echo error)" in
            applied) systemctl --user restart zotero-mcp.service 2>/dev/null || true; echo -e "  \033[32mCitation graph patch applied + zotero-mcp.service restarted.\033[0m" ;;
            already) echo -e "  Already patched." ;;
            mismatch*) echo -e "  \033[33mWARNING: graph patch pattern changed upstream; not applied — review manually.\033[0m" ;;
            *) echo -e "  \033[33mGraph patch failed; review manually.\033[0m" ;;
        esac
    fi

    echo -e "\n\033[34m=== Rebuilding pi-safe Container ===\033[0m"
    if [[ -f "$HOME/dotfiles/dot_pi/Containerfile" ]]; then
        echo -e "\033[36m  \$ podman build --no-cache -t localhost/pi-safe:latest ...\033[0m"
        podman build --no-cache -t localhost/pi-safe:latest -f "$HOME/dotfiles/dot_pi/Containerfile" "$HOME/dotfiles" || true
    else
        echo -e "\033[31m  pi-safe Containerfile not found, skipping.\033[0m"
    fi

    echo -e "\n\033[34m=== Updating Dual-Toolbox LLM Engines in Lemonade ===\033[0m"
    if podman inspect lemonade 2>/dev/null | grep -q 'lemonade'; then
        echo -e "\033[36m  Compiling ROCm and Vulkan binaries from source (Ubuntu 24.04)...\033[0m"
        podman run --rm -v lemonade-llama:/out:rw,z docker.io/rocm/dev-ubuntu-24.04:7.2.4-complete bash -c '
            set -euo pipefail
            export DEBIAN_FRONTEND=noninteractive
            apt-get update -qq
            apt-get install -y -qq git cmake build-essential curl libvulkan-dev glslc glslang-tools spirv-headers spirv-tools libssl-dev

            export PATH=/opt/rocm/bin:$PATH

            echo "Building Vulkan (Nathanw1014)..."
            export CC=gcc
            export CXX=g++
            git clone -b strix-halo-vulkan --depth=1 https://github.com/samuelueluel/strix-halo-llamacpp-nudge.git /tmp/vulkan-src
            cd /tmp/vulkan-src
            cmake -B build -DGGML_VULKAN=ON -DBUILD_SHARED_LIBS=OFF -DCMAKE_BUILD_TYPE=Release
            cmake --build build --config Release -j$(nproc)
            mkdir -p /out/vulkan
            curl -L https://github.com/Nathanw1014/strix-halo-llamacpp/releases/latest/download/strix-halo-llamacpp-vulkan-portable.tar.gz | tar xz -C /out/vulkan --strip-components=1 || true
            rm -f /out/vulkan/bin/lib*.so*
            cp -f build/bin/llama-server build/bin/llama-cli build/bin/llama-bench /out/vulkan/bin/ || true
            cp -Pf build/bin/*.so* /out/vulkan/bin/ 2>/dev/null || true
        ' || true
            
        echo -e "\033[36m  Compiling ROCm HIP engine (Gaetan Puleo - Strix Halo gfx1151)...\033[0m"
        podman run --rm -v lemonade-llama:/out:rw,z docker.io/rocm/dev-ubuntu-24.04:7.14.0-full bash -c '
            set -euo pipefail
            export DEBIAN_FRONTEND=noninteractive
            export PATH=/opt/rocm/bin:$PATH
            apt-get update -qq && apt-get install -y -qq git cmake build-essential libssl-dev

            git clone --depth=1 https://github.com/gaetan-puleo/llama-cpp-strix-halo.git /tmp/rocm-src
            cd /tmp/rocm-src
            cmake -B build \
                -DGGML_HIP=ON \
                -DAMDGPU_TARGETS=gfx1151 \
                -DGGML_HIP_ROCWMMA_FATTN=ON \
                -DCMAKE_BUILD_TYPE=Release
            cmake --build build --config Release -j$(nproc)

            OUT=/out/rocm.new
            rm -rf "$OUT"
            mkdir -p "$OUT/lib"
            cp -f build/bin/llama-server build/bin/llama-cli build/bin/llama-bench "$OUT/"
            cp -Pf build/bin/*.so* "$OUT/lib/" 2>/dev/null || true
            cp -aL /opt/rocm/lib/*.so* "$OUT/lib/" 2>/dev/null || true
            cp -aL /opt/rocm/llvm/lib/*.so* "$OUT/lib/" 2>/dev/null || true

            export LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/llvm/lib:"$OUT/lib":$PWD/build/bin
            declare -A seen=(); queue=("$OUT/llama-server" "$OUT/llama-cli" "$OUT/llama-bench" "$OUT/lib"/*.so*)
            while (( ${#queue[@]} )); do
                f="${queue[0]}"; queue=("${queue[@]:1}")
                while read -r lib; do
                    [ -f "$lib" ] || continue; [ "${seen[$lib]+1}" ] && continue
                    seen[$lib]=1; cp -aL "$lib" "$OUT/lib/" 2>/dev/null || true; queue+=("$lib")
                done < <(ldd "$f" 2>/dev/null | grep -oE "/[^ (]+" || true)
            done
            rm -rf /out/rocm
            mv "$OUT" /out/rocm
        ' || true

        echo -e "\033[36m  Syncing MoE/Dense dispatch wrapper (canonical: /usr/share/turquoise/llama-dispatch-wrapper.sh)...\033[0m"
        # lemond v10.8 launches /root/.cache/lemonade/bin/llamacpp/vulkan/llama-server for
        # llamacpp_backend=vulkan — NOT /opt/lemonade/llama/llama-server. Both locations must
        # hold this wrapper or DeepSeek models silently misroute to the ROCm engine (or a
        # Lemonade image upgrade overwrites the store copy with a stock binary).
        WRAPPER_SRC="$HOME/turquoise/files/system/usr/share/turquoise/llama-dispatch-wrapper.sh"
        [[ -f "$WRAPPER_SRC" ]] || WRAPPER_SRC=/usr/share/turquoise/llama-dispatch-wrapper.sh
        if [[ -f "$WRAPPER_SRC" ]]; then
            podman cp "$WRAPPER_SRC" lemonade:/opt/lemonade/llama/llama-server || true
            podman cp "$WRAPPER_SRC" lemonade:/root/.cache/lemonade/bin/llamacpp/vulkan/llama-server || true
            podman exec lemonade chmod +x /opt/lemonade/llama/llama-server /root/.cache/lemonade/bin/llamacpp/vulkan/llama-server || true
        else
            echo -e "\033[31m  WARNING: $WRAPPER_SRC not found (image predates wrapper deployment) — skipping wrapper sync.\033[0m"
        fi

        podman restart lemonade || true
        sleep 3
        if podman exec lemonade grep -q "force-rocm" /opt/lemonade/llama/llama-server 2>/dev/null; then
            echo -e "\033[32m  Dispatch wrapper verified (Dual-engine ROCm/Vulkan routing intact).\033[0m"
        else
            echo -e "\033[31m  WARNING: dispatch wrapper missing force-rocm patterns — verify routing!\033[0m"
        fi
    fi

    echo -e "\n\033[34m=== Updating Homebrew and Packages ===\033[0m"
    if command -v brew >/dev/null; then
        sudo chown -R "$(whoami):wheel" /home/linuxbrew 2>/dev/null || true
        sudo chmod -R g+rwX /home/linuxbrew 2>/dev/null || true
        echo -e "\033[36m  \$ brew update && brew upgrade && brew cleanup\033[0m"
        brew update && brew upgrade && brew cleanup
    else
        echo -e "\033[31m  Homebrew not found, skipping.\033[0m"
    fi

    echo -e "\n\033[34m=== Updating pipx Packages ===\033[0m"
    if command -v pipx >/dev/null; then
        sjust pipx
    else
        echo -e "\033[31m  pipx not found, skipping.\033[0m"
    fi

    echo -e "\n\033[34m=== Checking Firmware Updates ===\033[0m"
    fwupdmgr refresh && fwupdmgr get-updates || true

    echo -e "\n\033[32mUpdate sequence complete!\033[0m"

# Fix Btrfs transparent compression on composefs (Fedora 42+ / Bluefin 44+)
fix-compression:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Applying Btrfs zstd compression workaround..."

    # 1. Update kernel args if not already present
    if rpm-ostree kargs | grep -q "compress=zstd"; then
        echo "  Kernel arguments already updated."
    else
        echo "  Adding compress=zstd:1 to kernel arguments..."
        cur=$(rpm-ostree kargs | grep -o 'rootflags=[^ ]*' || true)
        if [ -n "$cur" ]; then
            sudo rpm-ostree kargs --delete="$cur" --append="${cur},compress=zstd:1"
        else
            sudo rpm-ostree kargs --append=rootflags=subvol=root,compress=zstd:1
        fi
    fi

    # 2. Comment out root mount in /etc/fstab if not already commented
    if grep -E '^[^\#].*\s+/\s+btrfs' /etc/fstab >/dev/null; then
        echo "  Commenting out root mount in /etc/fstab..."
        sudo sed -i.bak 's/^\([^#].*\s\+\/\s\+btrfs\)/# \1/' /etc/fstab
        echo "  /etc/fstab updated (backup saved as /etc/fstab.bak)."
    else
        echo "  Root mount in /etc/fstab is already commented out."
    fi

    echo "Workaround applied. Please reboot your system to activate compression."

# ── HP ZBook Ultra G1a (Strix Halo) — turquoise-halo only ────────────────────
# Everything the turquoise-halo image can't/shouldn't bake: per-machine post-
# install (compression, groups, amd-debug-tools), verification of baked features,
# and the NPU kernel-arg toggle. Hardware notes:
#   ~/Dropbox/.../Custom Image/HP ZBook Ultra G1a 14'' Ryzen AI Max+ 395.md
#   ~/Dropbox/.../Local LLMs/Strix Halo LLM Guide.md
# Guarded by /usr/share/turquoise/image-id so they no-op on the P14s.

# Strix Halo post-install: compression, groups, suspend tools, then verify (turquoise-halo only)
halo:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "$(cat /usr/share/turquoise/image-id 2>/dev/null)" != "turquoise-halo" ]]; then
        echo -e "\033[31mThis recipe is for the turquoise-halo image (HP ZBook Ultra G1a) only.\033[0m"
        echo "  Current image-id: $(cat /usr/share/turquoise/image-id 2>/dev/null || echo unknown)"
        exit 1
    fi

    echo -e "\033[34m=== 1/4 Groups + shell (sjust system) ===\033[0m"
    sjust system

    echo -e "\n\033[34m=== 2/4 Btrfs compression workaround (sjust fix-compression) ===\033[0m"
    sjust fix-compression

    echo -e "\n\033[34m=== 3/4 Suspend debug tools (amd-debug-tools → amd-s2idle) ===\033[0m"
    # Not packaged for Fedora — superm1's upstream pipx tool. Provides `amd-s2idle`.
    if command -v pipx >/dev/null && pipx list --short 2>/dev/null | grep -q '^amd-debug-tools'; then
        echo "  amd-debug-tools already installed."
    elif command -v pipx >/dev/null; then
        echo "  Installing amd-debug-tools via pipx..."
        pipx install amd-debug-tools || echo -e "  \033[33mInstall failed — run 'sjust pipx' / check network.\033[0m"
    else
        echo -e "  \033[33mpipx not found — run 'sjust pipx' first.\033[0m"
    fi

    echo -e "\n\033[34m=== 4/4 Verifying baked hardware enablement ===\033[0m"
    sjust halo-verify || true

    echo -e "\n\033[41;97m  MANUAL STEPS — NOT done by this script. You must do these yourself.  \033[0m"
    echo -e "\033[33m  (firmware/install-time settings; no software, including sjust, can apply them)\033[0m"
    echo ""
    echo -e "\033[36m  ▶ BIOS/UEFI — enter setup at boot and set each of these by hand:\033[0m"
    echo "      [ ] Secure Boot ............................ DISABLED  (required for the vanilla kernel)"
    echo "      [ ] Pluton ................................. ENABLED   (s2idle suspend breaks if disabled)"
    echo "      [ ] Integrated Graphics UMA Frame Buffer ... 512 MB    (not Auto/large)"
    echo "      [ ] Fan offset ............................. +2        (steady low spin instead of cycling)"
    echo "      [ ] ASPM ................................... default   (do not force off)"
    echo -e "\033[36m  ▶ Install-time (only relevant on a fresh install — already chosen at Anaconda):\033[0m"
    echo "      [ ] Btrfs + LUKS full-disk encryption"
    echo -e "\033[33m  None of the above are verified by 'sjust halo-verify' — they are firmware-only.\033[0m"
    echo ""
    echo -e "\033[36m  ▶ Now: REBOOT\033[0m to activate the compression workaround + any karg changes."
    echo -e "\033[36m  ▶ After reboot: run 'sjust halo-llm'\033[0m to set up the NPU distrobox + lemond service."
    echo -e "\n\033[32mhalo setup complete (automated steps).\033[0m Manual BIOS steps above are still up to you."

# Verify turquoise-halo baked features: kargs, webcam, sched-ext, NPU, suspend (read-only)
halo-verify:
    #!/usr/bin/env bash
    set -uo pipefail
    pass() { echo -e "  \033[32m✓\033[0m $*"; }
    warn() { echo -e "  \033[33m!\033[0m $*"; }
    fail() { echo -e "  \033[31m✗\033[0m $*"; }

    if [[ "$(cat /usr/share/turquoise/image-id 2>/dev/null)" != "turquoise-halo" ]]; then
        warn "image-id is not turquoise-halo — these checks assume the Halo image."
    fi

    echo -e "\033[34mKernel arguments (baked via kargs module)\033[0m"
    KARGS="$(rpm-ostree kargs 2>/dev/null || true)"
    for arg in amd_pstate=active ttm.pages_limit=32505856 amd_iommu=off; do
        grep -q -- "$arg" <<<"$KARGS" && pass "$arg" || fail "$arg MISSING"
    done
    grep -q 'compress=zstd' <<<"$KARGS" && pass "compress=zstd in kargs" \
        || warn "compress=zstd not in kargs — run 'sjust fix-compression' + reboot"

    echo -e "\033[34mBtrfs compression (journal)\033[0m"
    if journalctl -k -g 'use zstd compression' 2>/dev/null | grep -q zstd; then
        pass "btrfs zstd compression active"
    else
        warn "no 'use zstd compression' in kernel log (reboot after fix-compression, or check perms)"
    fi

    echo -e "\033[34mWebcam — AMD ISP4 kmod (built at image time)\033[0m"
    if [[ -d /sys/module/amd_isp4_capture ]] || (command -v lsmod >/dev/null && lsmod | grep -q amd_isp4_capture); then
        pass "amd_isp4_capture loaded"
    else
        warn "amd_isp4_capture not loaded"
    fi
    if command -v v4l2-ctl >/dev/null; then
        v4l2-ctl --list-devices 2>/dev/null | grep -qi isp && pass "ISP4 video device present" \
            || warn "no ISP4 device in v4l2-ctl --list-devices"
    fi

    echo -e "\033[34msched-ext schedulers\033[0m"
    systemctl is-enabled scx_loader.service &>/dev/null && pass "scx_loader.service enabled" || fail "scx_loader.service not enabled"
    SCX="$(scxctl get 2>/dev/null || sudo -n scxctl get 2>/dev/null || true)"
    [[ -n "$SCX" ]] && pass "active scheduler: $SCX" || warn "scxctl get returned nothing (try: sudo scxctl get)"

    echo -e "\033[34mAC-wakeup suspend fix\033[0m"
    systemctl is-enabled ac-wakeup-disable.service &>/dev/null && pass "ac-wakeup-disable.service enabled" || fail "ac-wakeup-disable.service not enabled"

    echo -e "\033[34mKeyboard suspend wakeup fix\033[0m"
    if [[ -f /sys/bus/serio/devices/serio0/power/wakeup ]]; then
        WAKE_STATE="$(cat /sys/bus/serio/devices/serio0/power/wakeup 2>/dev/null || true)"
        if [[ "$WAKE_STATE" == "disabled" ]]; then
            pass "serio0 keyboard wakeup disabled"
        else
            warn "serio0 keyboard wakeup is $WAKE_STATE (should be disabled via udev)"
        fi
    else
        warn "serio0 keyboard wakeup file not found"
    fi

    echo -e "\033[34miGPU memory (GTT)\033[0m"
    if journalctl -k -g 'GTT memory' 2>/dev/null | grep -qi 'GTT memory'; then
        pass "$(journalctl -k -g 'GTT memory' 2>/dev/null | tail -1 | sed 's/.*]: *//')"
    else
        warn "no 'GTT memory' line in kernel log (check perms or reboot)"
    fi

    echo -e "\033[34mNPU (XDNA2 / amdxdna)\033[0m"
    if [[ -e /dev/accel/accel0 ]]; then
        pass "/dev/accel/accel0 present"
    else
        warn "/dev/accel/accel0 absent — NPU off (amd_iommu=off set?) or kernel/firmware too old"
    fi
    MLOCK_CONF=/etc/systemd/system/user@.service.d/memlock.conf
    [[ -f "$MLOCK_CONF" ]] \
        && pass "LimitMEMLOCK=infinity configured ($MLOCK_CONF)" \
        || warn "memlock limit not raised — run 'sjust halo-llm'"
    distrobox list 2>/dev/null | grep -q 'npu-lemonade' \
        && pass "npu-lemonade distrobox exists" \
        || warn "npu-lemonade distrobox missing — run 'sjust halo-llm'"
    if systemctl --user is-active --quiet npu-lemond.service 2>/dev/null; then
        pass "npu-lemond.service active (lemond :13305, NPU-enabled)"
    elif systemctl --user is-active --quiet lemond.service 2>/dev/null; then
        warn "lemond.service active (host RPM, no NPU) — run 'sjust halo-llm' to switch to NPU build"
    else
        warn "no lemond service running — run 'sjust halo-llm'"
    fi

    echo -e "\033[34mSuspend test tooling\033[0m"
    command -v amd-s2idle >/dev/null && pass "amd-s2idle available — run 'sudo amd-s2idle test' to validate s2idle" \
        || warn "amd-s2idle not installed — run 'sjust halo' or 'pipx install amd-debug-tools'"


# Set up the local NPU LLM stack inside an Ubuntu distrobox: XRT + FastFlowLM (NPU backend) +
# Lemonade (orchestrator on :13305), memlock fix, user service (turquoise-halo only).
# Lemonade is the server clients talk to; it calls FLM for NPU models and llama.cpp for GGUFs.
# Run after 'sjust halo' + reboot. Idempotent and self-healing — each piece is checked
# independently, so a partial/interrupted run is completed (not redone) on the next invocation.
# See: ~/Dropbox/.../Local LLMs/Strix Halo LLM Guide.md §2.C / §5.B.2
halo-llm:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "$(cat /usr/share/turquoise/image-id 2>/dev/null)" != "turquoise-halo" ]]; then
        echo -e "\033[31mThis recipe is for the turquoise-halo image only.\033[0m"; exit 1
    fi
    pass() { echo -e "  \033[32m✓\033[0m $*"; }
    info() { echo -e "  \033[34m→\033[0m $*"; }
    fail() { echo -e "  \033[31m✗\033[0m $*"; }

    # 1. Memlock — NPU inference requires locking model weights in RAM (default 8 MB is too low)
    echo -e "\n\033[34m=== 1/4 Memlock limit (LimitMEMLOCK=infinity) ===\033[0m"
    MLOCK_CONF=/etc/systemd/system/user@.service.d/memlock.conf
    if [[ -f "$MLOCK_CONF" ]]; then
        pass "Already configured."
    else
        sudo mkdir -p "$(dirname "$MLOCK_CONF")"
        printf '[Service]\nLimitMEMLOCK=infinity\n' | sudo tee "$MLOCK_CONF" >/dev/null
        sudo systemctl daemon-reload
        pass "Configured. You must reboot (or log out/in) before NPU inference will work in this session."
    fi

    # 2. npu-lemonade distrobox — Ubuntu 24.04 with /dev/accel/accel0 for the XDNA2 NPU.
    # FLM (FastFlowLM) only ships Ubuntu/Debian debs; this box provides the XRT + FLM runtime
    # that the host Fedora image can't install directly.
    echo -e "\n\033[34m=== 2/4 npu-lemonade distrobox (Ubuntu 24.04 + NPU device) ===\033[0m"
    if distrobox list 2>/dev/null | grep -q 'npu-lemonade'; then
        pass "Already exists."
    else
        info "Creating distrobox with /dev/accel/accel0 passthrough..."
        distrobox create --name npu-lemonade \
            --image docker.io/library/ubuntu:24.04 \
            --additional-flags "--device /dev/accel/accel0" \
            --yes
        pass "Created."
    fi

    # 3. XRT + Lemonade + FastFlowLM inside the distrobox — two INDEPENDENT installs so a
    # partial state (e.g. FLM present but Lemonade missing) is completed, not redone, on re-run:
    #   - lemonade-server (PPA) → 'lemond' (server daemon) + 'lemonade' (CLI) — the orchestrator
    #   - FastFlowLM (GitHub .deb) → 'flm' — the NPU inference backend Lemonade calls
    # amdxdna-dkms is deliberately NOT installed: the host's in-tree kernel-7.0 amdxdna driver
    # already provides /dev/accel/accel0, and a DKMS build inside the container would target the
    # wrong (container) kernel headers, not the running host kernel.
    echo -e "\n\033[34m=== 3/4 XRT + Lemonade + FastFlowLM inside distrobox ===\033[0m"
    inbox() { distrobox enter npu-lemonade -- bash -lc "$1"; }

    # 3a. XRT + Lemonade from ppa:lemonade-team/stable
    if inbox 'command -v lemond' &>/dev/null; then
        pass "Lemonade (lemond) already installed."
    else
        info "Installing XRT + Lemonade from ppa:lemonade-team/stable (apt — a few minutes)..."
        inbox '
            set -euo pipefail
            sudo apt-get update -qq
            sudo apt-get install -y -qq software-properties-common wget
            sudo add-apt-repository -y ppa:lemonade-team/stable 2>&1 | tail -1
            sudo apt-get update -qq
            sudo apt-get install -y -qq libxrt-npu2 lemonade-server
        '
        pass "Lemonade installed."
    fi

    # 3b. FastFlowLM (NPU backend) — latest ubuntu24.04 .deb from GitHub releases
    if inbox 'command -v flm' &>/dev/null; then
        pass "FastFlowLM (flm) already installed."
    else
        info "Fetching latest FLM ubuntu24.04 .deb..."
        FLM_URL=$(curl -sf https://api.github.com/repos/FastFlowLM/FastFlowLM/releases/latest \
            | python3 -c "import json,sys; a=[x for x in json.load(sys.stdin)['assets'] if 'ubuntu24.04' in x['name'] and x['name'].endswith('.deb')]; print(a[0]['browser_download_url'] if a else '')")
        [[ -n "$FLM_URL" ]] || { fail "No FLM ubuntu24.04 .deb asset found in the latest release."; exit 1; }
        info "Installing FLM ($FLM_URL)..."
        inbox "
            set -euo pipefail
            wget -q '$FLM_URL' -O /tmp/flm.deb
            sudo apt-get install -y -qq /tmp/flm.deb
            rm -f /tmp/flm.deb
        "
        pass "FastFlowLM installed."
    fi

    info "Validating NPU stack..."
    inbox 'flm validate'

    # 4. npu-lemond user service — runs the in-box lemond (XRT + FLM aware) on :13305.
    # Distrobox shares the host network namespace, so 127.0.0.1:13305 is identical inside and out.
    # The host RPM lemond has no XRT/FLM, so it's disabled to avoid grabbing the port first.
    echo -e "\n\033[34m=== 4/4 npu-lemond user service ===\033[0m"
    if ! inbox 'command -v lemond' &>/dev/null; then
        fail "lemond not found in the distrobox — step 3a did not complete. Aborting before service setup."
        exit 1
    fi
    systemctl --user disable --now lemond.service 2>/dev/null || true   # host RPM lemond (NPU-incapable)

    UNIT="$HOME/.config/systemd/user/npu-lemond.service"
    mkdir -p "$(dirname "$UNIT")"
    printf '%s\n' \
        '[Unit]' \
        'Description=Lemonade Server (NPU) via npu-lemonade distrobox' \
        '' \
        '[Service]' \
        'Type=simple' \
        'ExecStart=distrobox enter npu-lemonade -- bash -lc "exec lemond"' \
        'Restart=on-failure' \
        'RestartSec=5s' \
        '' \
        '[Install]' \
        'WantedBy=default.target' \
        > "$UNIT"
    systemctl --user daemon-reload
    systemctl --user enable --now npu-lemond.service
    sleep 3
    if systemctl --user is-active --quiet npu-lemond.service; then
        pass "npu-lemond.service running on :13305"
    else
        fail "Service not active yet — check: journalctl --user -u npu-lemond.service -n 30"
    fi

    echo ""
    echo -e "\033[32mNPU stack ready (Lemonade + FastFlowLM on :13305).\033[0m"
    echo "  Pull NPU models via the lemonade CLI (the server is running now):"
    echo "    distrobox enter npu-lemonade -- lemonade list   # NPU models are the 'flm'-backend rows (-FLM suffix)"
    echo "    # Autocomplete — FastFlowLM has NO dedicated coder, so use a small GENERAL NPU model:"
    echo "    distrobox enter npu-lemonade -- lemonade pull qwen2.5-it-3b-FLM"
    echo "    # Embeddings on the NPU (silent, ~3W) — FLM's only embedder:"
    echo "    distrobox enter npu-lemonade -- lemonade pull embed-gemma-300m-FLM"
    echo "    # Higher-quality embeddings (runs on the iGPU via llama.cpp, NOT the NPU):"
    echo "    distrobox enter npu-lemonade -- lemonade pull user.nomic-embed --checkpoint 'nomic-ai/nomic-embed-text-v1-GGUF:Q4_K_S' --recipe llamacpp --label embeddings"
    echo ""
    echo "  iGPU models (ramalama aliases from ~/.zshrc):"
    echo "    serve-code   serve-think   serve-edit   serve-autocomplete   serve-embedder"
    echo ""
    echo "  NOTE: if this was the first memlock configuration, reboot before NPU inference works."

# Provision the iGPU LLM stack: the kyuz0 Strix Halo Vulkan/RADV llama.cpp toolbox image +
# iGPU models for ramalama (turquoise-halo only). This is the big-reasoning iGPU path that
# complements the NPU stack from 'halo-llm'. ramalama itself comes from ~/.Brewfile (sjust brew);
# serve-code/serve-think/serve-edit/serve-autocomplete/serve-embedder aliases come from ~/.zshrc.
# Pulls three models: ~37 GB Qwen3.6-35B-A3B MoE brain (serve-code :8080), ~1 GB
# Qwen2.5-Coder-1.5B FIM coder (serve-autocomplete :8081, Zed edit prediction —
# the NPU has no coder model so FIM completion must run here), ~4.6 GB Qwen3-Embedding-8B.
# Run after 'sjust brew'. Idempotent — image and both models are pulled only if absent, so
# re-running on a provisioned box is a no-op.
# See: ~/Dropbox/.../Local LLMs/Strix Halo LLM Guide.md §2.A / §2.B / §2.J
halo-llm-gpu:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "$(cat /usr/share/turquoise/image-id 2>/dev/null)" != "turquoise-halo" ]]; then
        echo -e "\033[31mThis recipe is for the turquoise-halo image only.\033[0m"; exit 1
    fi
    pass() { echo -e "  \033[32m✓\033[0m $*"; }
    info() { echo -e "  \033[34m→\033[0m $*"; }
    fail() { echo -e "  \033[31m✗\033[0m $*"; }

    RAMA_IMG=ghcr.io/nathanw1014/strix-halo-llamacpp:vulkan
    BRAIN_MODEL=hf://unsloth/Qwen3.6-35B-A3B-MTP-GGUF:UD-Q8_K_XL
    CODER_MODEL=hf://Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF:Q4_K_M
    EMBED_MODEL=hf://Qwen/Qwen3-Embedding-8B-GGUF:Q4_K_M

    # 1. ramalama — installed via ~/.Brewfile (sjust brew). Serving happens through the
    # serve-code/serve-think/serve-edit aliases in ~/.zshrc (with MTP speculative-decoding opts).
    echo -e "\n\033[34m=== 1/6 ramalama present ===\033[0m"
    if command -v ramalama &>/dev/null; then
        pass "ramalama $(ramalama version 2>/dev/null | awk '{print $NF}') present."
    else
        fail "ramalama not found — run 'sjust brew' first (it's declared in ~/.Brewfile)."
        exit 1
    fi

    # 2. Nathanw1014 Strix Halo toolbox (Vulkan/RADV llama.cpp) — the container ramalama serves into.
    # RADV is the stable/fast path on RDNA 3.5; avoids ROCm instability on this APU.
    echo -e "\n\033[34m=== 2/6 Vulkan/RADV toolbox image ===\033[0m"
    if podman image exists "$RAMA_IMG"; then
        pass "Image already present: $RAMA_IMG"
    else
        info "Pulling $RAMA_IMG (several GB)..."
        podman pull "$RAMA_IMG"
        pass "Pulled."
    fi

    # 3. Brain model — Qwen3.6-35B-A3B MoE, Q8 + MTP draft weights (~37 GB GGUF).
    echo -e "\n\033[34m=== 3/6 Qwen3.6-35B-A3B brain model (~37 GB) ===\033[0m"
    if ramalama list 2>/dev/null | grep -q 'Qwen3.6-35B-A3B-MTP'; then
        pass "Model already pulled."
    else
        info "Pulling $BRAIN_MODEL (~37 GB — this takes a while)..."
        ramalama pull "$BRAIN_MODEL"
        pass "Pulled."
    fi

    # 4. Autocomplete coder — small Qwen2.5-Coder GGUF (~1 GB) for Zed edit prediction via the
    # serve-autocomplete alias on :8081, alongside the main model. FIM-capable (real code, not prose);
    # NPU has no coder model so this must live on the iGPU. Zed "edit_predictions" role → :8081.
    echo -e "\n\033[34m=== 4/6 Qwen2.5-Coder-1.5B autocomplete model (~1 GB) ===\033[0m"
    if ramalama list 2>/dev/null | grep -q 'Qwen2.5-Coder-1.5B'; then
        pass "Model already pulled."
    else
        info "Pulling $CODER_MODEL (~1 GB)..."
        ramalama pull "$CODER_MODEL"
        pass "Pulled."
    fi

    # 5. Embedder model — Qwen3-Embedding-8B GGUF (~4.6 GB) for vector embeddings via the
    # serve-embedder alias on :8082, replacing the old NPU-based FastFlowLM embedder.
    echo -e "\n\033[34m=== 5/6 Qwen3-Embedding-8B embedder model (~4.6 GB) ===\033[0m"
    if ramalama list 2>/dev/null | grep -q 'Qwen3-Embedding-8B'; then
        pass "Model already pulled."
    else
        info "Pulling $EMBED_MODEL (~4.6 GB)..."
        ramalama pull "$EMBED_MODEL"
        pass "Pulled."
    fi

    # 6. OpenCode SearXNG venv — tiny Python venv (~15 MB) that backs the stdio MCP extension
    # registered in ~/.config/opencode/opencode.json. The MCP script and config are in dotfiles
    # (chezmoi); only the venv must be created on first provision since it can't go in dotfiles.
    echo -e "\n\033[34m=== 6/6 OpenCode SearXNG venv ===\033[0m"
    VENV="$HOME/.config/opencode/searxng-venv"
    if [[ -x "$VENV/bin/python3" ]]; then
        pass "Venv already present at $VENV"
    else
        info "Creating venv at $VENV..."
        mkdir -p "$(dirname "$VENV")"
        python3 -m venv "$VENV"
        "$VENV/bin/pip" install --quiet "mcp[cli]" requests
        pass "Created and installed mcp + requests."
    fi

    echo ""
    echo -e "\033[32miGPU LLM ready.\033[0m Serve it (open a NEW shell so the aliases are available):"
    echo "    serve-code                               # main model on :8080 (chat/edit, MTP)"
    echo "    serve-think                              # dense 27B on :8080 (high-stakes reasoning)"
    echo "    serve-autocomplete                       # FIM coder on :8081 (Zed edit prediction)"
    echo "    serve-embedder                           # embedder on :8082"
    echo "    model-check                              # verify which model is loaded on each port"
    echo "    curl -sf http://localhost:8080/v1/models # verify the main model endpoint is up"
    echo "    amdgpu_top                               # watch GTT (NOT the 512 MB VRAM line) for real GPU-RAM use"
    echo ""
    echo "  Sandboxed coding agent (opencode-safe-* aliases in ~/.zshrc):"
    echo "    opencode-rebuild                         # (re)build the container image"
    echo "    opencode-safe-1 [dir]                    # writable dir + read-only home"
    echo "    opencode-safe-2 [dir]                    # writable dir only (no home access)"

# Open WebUI — local AI chat frontend (proper LaTeX/markdown rendering, conversation
# history, RAG) pointed at the ramalama iGPU server on :8080. Runs as a Podman container
# managed by systemd via Quadlet, listening on :3000. Auth is on; first browser visit
# creates the admin account. LAN access also needs the firewall port (printed at the end).
# Idempotent — re-running just ensures the unit + image + service are in place.
# See: ~/Dropbox/.../Local LLMs/Strix Halo LLM Guide.md §2.H (clients)
halo-llm-webui:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "$(cat /usr/share/turquoise/image-id 2>/dev/null)" != "turquoise-halo" ]]; then
        echo -e "\033[31mThis recipe is for the turquoise-halo image only.\033[0m"; exit 1
    fi
    pass() { echo -e "  \033[32m✓\033[0m $*"; }
    info() { echo -e "  \033[34m→\033[0m $*"; }
    fail() { echo -e "  \033[31m✗\033[0m $*"; }

    WEBUI_IMG=ghcr.io/open-webui/open-webui:main
    QUADLET="$HOME/.config/containers/systemd/open-webui.container"

    # 1. Quadlet unit — systemd generates open-webui.service from this .container file.
    # Network=host so the container reaches ramalama on localhost:8080; PORT=3000 avoids the
    # :8080 collision. Bound to all interfaces (LAN); WEBUI_AUTH=True gates it with a login.
    echo -e "\n\033[34m=== 1/3 Quadlet unit ===\033[0m"
    mkdir -p "$(dirname "$QUADLET")"
    printf '%s\n' \
        '[Unit]' \
        'Description=Open WebUI (local AI chat frontend → ramalama :8080)' \
        'After=network-online.target' \
        'Wants=network-online.target' \
        '' \
        '[Container]' \
        'ContainerName=open-webui' \
        "Image=$WEBUI_IMG" \
        'Network=host' \
        'Environment=PORT=3000' \
        'Environment=OPENAI_API_BASE_URL=http://localhost:8080/v1' \
        'Environment=OPENAI_API_KEY=dummy' \
        'Environment=ENABLE_OLLAMA_API=False' \
        'Environment=WEBUI_AUTH=True' \
        'Environment=WEBUI_NAME=ZBook Local AI' \
        'Volume=open-webui:/app/backend/data' \
        'AutoUpdate=registry' \
        '' \
        '[Service]' \
        'Restart=always' \
        'TimeoutStartSec=900' \
        '' \
        '[Install]' \
        'WantedBy=default.target' \
        > "$QUADLET"
    pass "Wrote $QUADLET"

    # 2. Image
    echo -e "\n\033[34m=== 2/3 Open WebUI image ===\033[0m"
    if podman image exists "$WEBUI_IMG"; then
        pass "Image already present."
    else
        info "Pulling $WEBUI_IMG (~4 GB)..."
        podman pull "$WEBUI_IMG"
        pass "Pulled."
    fi

    # 3. Service
    echo -e "\n\033[34m=== 3/3 open-webui.service ===\033[0m"
    systemctl --user daemon-reload
    systemctl --user start open-webui.service
    for i in $(seq 1 30); do curl -sf http://localhost:3000/health >/dev/null 2>&1 && break; sleep 3; done
    if systemctl --user is-active --quiet open-webui.service && curl -sf http://localhost:3000/health >/dev/null 2>&1; then
        pass "Running and healthy on :3000"
    else
        fail "Not healthy yet — check: journalctl --user -u open-webui.service -n 40"
    fi

    echo ""
    echo -e "\033[32mOpen WebUI ready.\033[0m"
    echo "  Local:  http://localhost:3000"
    echo "  LAN:    http://$(ip -4 addr show scope global | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1):3000"
    echo ""
    echo "  LAN access also needs (one-time, sudo):"
    echo "    sudo firewall-cmd --add-port=3000/tcp --permanent && sudo firewall-cmd --reload"
    echo "    loginctl enable-linger $USER      # start at boot without an active login"

# Set up SearXNG as a local web search backend for Open WebUI.
# SearXNG is a self-hosted meta search engine that provides Open WebUI's agentic
# web search with no API key and no rate limits.
# See: ~/Dropbox/.../Local LLMs/Strix Halo LLM Guide.md § 8.D.3
# Idempotent — re-running ensures the config, image, and service are in place.
halo-llm-searxng:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "$(cat /usr/share/turquoise/image-id 2>/dev/null)" != "turquoise-halo" ]]; then
        echo -e "\033[31mThis recipe is for the turquoise-halo image only.\033[0m"; exit 1
    fi
    pass() { echo -e "  \033[32m✓\033[0m $*"; }
    info() { echo -e "  \033[34m→\033[0m $*"; }
    fail() { echo -e "  \033[31m✗\033[0m $*"; }

    SEARXNG_IMG=docker.io/searxng/searxng:latest
    QUADLET="$HOME/.config/containers/systemd/searxng.container"
    CONFIG_DIR="$HOME/.config/searxng"
    SETTINGS="$CONFIG_DIR/settings.yml"

    # 1. Config
    echo -e "\n\033[34m=== 1/3 SearXNG config ===\033[0m"
    mkdir -p "$CONFIG_DIR"
    if [[ -f "$SETTINGS" ]]; then
        pass "settings.yml already present — skipping."
    else
        info "Writing settings.yml..."
        SECRET=$(openssl rand -hex 32)
        printf '%s\n' \
            'use_default_settings: true' \
            '' \
            'server:' \
            "  secret_key: \"$SECRET\"" \
            '  limiter: false' \
            '  image_proxy: false' \
            '' \
            'search:' \
            '  formats:' \
            '    - html' \
            '    - json' \
            > "$SETTINGS"
        pass "Wrote $SETTINGS"
    fi

    # 2. Quadlet unit
    echo -e "\n\033[34m=== 2/3 Quadlet unit ===\033[0m"
    printf '%s\n' \
        '[Unit]' \
        'Description=SearXNG (local web search backend for Open WebUI)' \
        'After=network-online.target' \
        'Wants=network-online.target' \
        '' \
        '[Container]' \
        'ContainerName=searxng' \
        "Image=$SEARXNG_IMG" \
        'PublishPort=8888:8080' \
        "Volume=$CONFIG_DIR:/etc/searxng:Z" \
        'AutoUpdate=registry' \
        '' \
        '[Service]' \
        'Restart=always' \
        '' \
        '[Install]' \
        'WantedBy=default.target' \
        > "$QUADLET"
    pass "Wrote $QUADLET"

    # 3. Image + service
    echo -e "\n\033[34m=== 3/3 SearXNG image + service ===\033[0m"
    if podman image exists "$SEARXNG_IMG"; then
        pass "Image already present."
    else
        info "Pulling $SEARXNG_IMG..."
        podman pull "$SEARXNG_IMG"
        pass "Pulled."
    fi
    systemctl --user daemon-reload
    systemctl --user start searxng.service
    for i in $(seq 1 15); do curl -sf "http://localhost:8888/search?q=test&format=json" >/dev/null 2>&1 && break; sleep 2; done
    if curl -sf "http://localhost:8888/search?q=test&format=json" >/dev/null 2>&1; then
        pass "Running and responding on :8888"
    else
        fail "Not healthy — check: journalctl --user -u searxng.service -n 40"
    fi

    echo ""
    echo -e "\033[32mSearXNG ready.\033[0m"
    echo "  Search API: http://localhost:8888/search?q=test&format=json"
    echo ""
    echo "  Configure Open WebUI (Admin Panel → Settings → Web Search):"
    echo "    Engine:                  SearXNG"
    echo "    Query URL:               http://localhost:8888/search?q=<query>&format=json"
    echo "    Bypass Web Loader:       on"
    echo "    Bypass Embedding+RAG:    on"

# Build the sandboxed OpenCode container image (localhost/opencode-safe:latest).
# The Dockerfile and opencode.json live in ~/.config/opencode (chezmoi-managed dotfiles).
# Re-run after updating ~/.config/opencode/Dockerfile or any config it bakes in.
# After building, use the opencode-safe-1/2/3 aliases in ~/.zshrc (see § 2.E of the LLM Guide).
halo-llm-opencode:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "$(cat /usr/share/turquoise/image-id 2>/dev/null)" != "turquoise-halo" ]]; then
        echo -e "\033[31mThis recipe is for the turquoise-halo image only.\033[0m"; exit 1
    fi
    pass() { echo -e "  \033[32m✓\033[0m $*"; }
    info() { echo -e "  \033[34m→\033[0m $*"; }

    DOCKERFILE="$HOME/.config/opencode/Dockerfile"
    if [[ ! -f "$DOCKERFILE" ]]; then
        echo -e "\033[31mDockerfile not found at $DOCKERFILE. Restore dotfiles first (chezmoi apply).\033[0m"
        exit 1
    fi

    echo -e "\n\033[34m=== Building localhost/opencode-safe:latest ===\033[0m"
    info "Building from $HOME/.config/opencode ..."
    podman build --no-cache -t localhost/opencode-safe:latest "$HOME/.config/opencode"
    pass "Image built and ready."

    echo ""
    echo -e "\033[32mOpenCode sandbox ready.\033[0m"
    echo "  Use the opencode-safe-* aliases in ~/.zshrc (see § 2.E of the LLM Guide):"
    echo "    opencode-safe-1 [dir]   # writable dir + read-only home"
    echo "    opencode-safe-2 [dir]   # writable dir only (no home access)"
    echo "    opencode-safe-3 <file>  # single-file write access"

