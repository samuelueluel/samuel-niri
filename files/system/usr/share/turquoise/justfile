            mismatch*) echo -e "  \033[33mWARNING: instruct patch pattern changed upstream; not applied — review manually.\033[0m" ;;
            *) echo -e "  \033[33mInstruct patch failed; review manually.\033[0m" ;;
        esac
    fi

    # zotero-mcp-server: re-apply the PDF-outline child-script patch (idempotent).
    # zotero_get_pdf_outline extracts the TOC in a throwaway child whose stdout must
    # be pure JSON; PyMuPDF>=1.26 prints a deprecation warning to STDOUT when importing
    # the legacy `fitz` name, corrupting it ("unreadable outline data"). The patch makes
    # the child import `pymupdf as fitz` instead (warning-free, API-identical).
    # Marker: [toc patch]. This patch file itself lives in the turquoise repo like the others.
    echo -e "\033[36m  Re-applying zotero-mcp PDF-outline child-script patch...\033[0m"
    ZMPKG=$(find "$HOME/.local/share/uv/tools/zotero-mcp-server/lib" -type d -name zotero_mcp 2>/dev/null | head -1)
    ZTPATCH=/usr/share/turquoise/zotero-mcp-toc-patch.py
    [[ -f "$ZTPATCH" ]] || ZTPATCH="$HOME/turquoise/files/system/usr/share/turquoise/zotero-mcp-toc-patch.py"
    if [[ -z "$ZMPKG" ]]; then
        echo -e "  \033[33mzotero-mcp-server not installed — skipping toc patch.\033[0m"
    elif [[ ! -f "$ZTPATCH" ]]; then
        echo -e "  \033[33mzotero-mcp-toc-patch.py not found; review manually.\033[0m"
    else
        case "$(python3 "$ZTPATCH" "$ZMPKG/tools/write.py" 2>/dev/null || echo error)" in
            applied) systemctl --user restart zotero-mcp.service 2>/dev/null || true; echo -e "  \033[32mTOC patch applied + zotero-mcp.service restarted.\033[0m" ;;
            already) echo -e "  Already patched." ;;
            mismatch*) echo -e "  \033[33mWARNING: toc patch pattern changed upstream; not applied — review manually.\033[0m" ;;
            *) echo -e "  \033[33mTOC patch failed; review manually.\033[0m" ;;
        esac
    fi

    # zotero-mcp-server: re-apply the Deterministic Contextual Retrieval patch (idempotent).
    # Prepends a lean structural prefix ([Paper: <title> | Section: <breadcrumb>])
    # to every chunk IN MEMORY before embedding/BM25 indexing, so regression
    # models and proofs keep their paper/section identity in both indexes.
    # Zero disk mutation of sidecars; sparse leg inherits via iter_documents().
    # Marker: [contextual patch]. See New-RAG-Setup.md (Extension 1: DCR).
    echo -e "\033[36m  Re-applying zotero-mcp Deterministic Contextual Retrieval patch...\033[0m"
    ZMPKG=$(find "$HOME/.local/share/uv/tools/zotero-mcp-server/lib" -type d -name zotero_mcp 2>/dev/null | head -1)
    ZCPATCH=/usr/share/turquoise/zotero-mcp-contextual-patch.py
    [[ -f "$ZCPATCH" ]] || ZCPATCH="$HOME/turquoise/files/system/usr/share/turquoise/zotero-mcp-contextual-patch.py"
    if [[ -z "$ZMPKG" ]]; then
        echo -e "  \033[33mzotero-mcp-server not installed — skipping contextual patch.\033[0m"
    elif [[ ! -f "$ZCPATCH" ]]; then
        echo -e "  \033[33mzotero-mcp-contextual-patch.py not found; review manually.\033[0m"
