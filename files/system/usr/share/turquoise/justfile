# Add user to all required groups and set zsh as default shell
system:
    #!/usr/bin/env bash
    set -euo pipefail
    ME="$(whoami)"

    add_group() {
        local grp="$1"
        getent group "$grp" &>/dev/null || { echo "  skipping $grp (group not found)"; return; }
        groups "$ME" | grep -qw "$grp" && return
        sudo usermod -aG "$grp" "$ME"
        echo "  added to $grp"
    }

    echo "Configuring group memberships..."
    for grp in wheel libvirt kvm lp optical storage video input i2c systemd-journal; do
        add_group "$grp"
    done

    ZSH_PATH="$(command -v zsh)"
    [[ "$SHELL" == "$ZSH_PATH" ]] || sudo usermod -s "$ZSH_PATH" "$ME"

# Configure 32GB swap file on /var and enable zswap (zstd) + swappiness 60
swap:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "=== Configuring Swap (32GB file on /var + zswap zstd + swappiness 60) ==="

    # 1. Disable ZRAM in favor of zswap + physical swapfile
    sudo touch /etc/systemd/zram-generator.conf
    sudo systemctl mask systemd-zram-setup@zram0.service 2>/dev/null || true
    sudo swapoff /dev/zram0 2>/dev/null || true

    # 2. Ensure /var/swapfile exists and is active
    if ! swapon --show | grep -q '/var/swapfile'; then
        echo "Creating 32GB swapfile on /var..."
        sudo rm -f /var/swapfile
        sudo btrfs filesystem mkswapfile --size 32G /var/swapfile
        sudo swapon /var/swapfile
        grep -q '/var/swapfile' /etc/fstab || echo '/var/swapfile none swap defaults 0 0' | sudo tee -a /etc/fstab
    else
        echo "Swapfile /var/swapfile already active."
    fi

    # 3. Enable zswap live & set swappiness
    echo "Enabling zswap (zstd) and swappiness 60 live..."
    sudo modprobe zstd 2>/dev/null || true
    echo zstd | sudo tee /sys/module/zswap/parameters/compressor >/dev/null
    echo 1 | sudo tee /sys/module/zswap/parameters/enabled >/dev/null
    sudo sysctl vm.swappiness=60 >/dev/null

    # 4. Persist zswap and swappiness across reboots
    echo "Setting persistent zswap & swappiness configuration..."
    sudo mkdir -p /etc/tmpfiles.d /etc/sysctl.d
    printf 'w- /sys/module/zswap/parameters/compressor - - - - zstd\nw- /sys/module/zswap/parameters/enabled - - - - 1\n' | sudo tee /etc/tmpfiles.d/zswap.conf >/dev/null
    printf 'vm.swappiness = 60\n' | sudo tee /etc/sysctl.d/99-swappiness.conf >/dev/null

    echo -e "\n=== Swap Status ==="
    swapon --show
    echo -n "zswap enabled: " && cat /sys/module/zswap/parameters/enabled
    echo -n "zswap compressor: " && cat /sys/module/zswap/parameters/compressor
    echo -n "vm.swappiness: " && sysctl -n vm.swappiness


# Configure SSH agent socket and load personal key (requires ~/.ssh/id_ed25519; not in setup)
ssh-setup:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ ! -f "$HOME/.ssh/id_ed25519" ]]; then
        echo "No ~/.ssh/id_ed25519 found — this recipe is for Samuel's personal setup only."
        exit 1
    fi
    systemctl --user enable --now ssh-agent.socket
    export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
    SSH_ASKPASS_REQUIRE=never ssh-add ~/.ssh/id_ed25519
    # Append auto-load snippet to ~/.zshrc if not already present
    if ! grep -q 'ssh-add.*id_ed25519' "$HOME/.zshrc" 2>/dev/null; then
        printf '\n# Auto-load SSH key on first terminal (added by sjust ssh-setup)\n[[ -S "$SSH_AUTH_SOCK" ]] && { ssh-add -l &>/dev/null || SSH_ASKPASS_REQUIRE=never ssh-add ~/.ssh/id_ed25519; }\n' >> "$HOME/.zshrc"
        echo "Added ssh-add auto-load to ~/.zshrc."
    fi
    echo "SSH agent socket enabled and key loaded."

# Set up Obsidian CLI wrapper — enables CLI toggle and verifies wrapper is deployed (not in setup)
obsidian-cli:
    #!/usr/bin/env bash
    set -euo pipefail
    OBSIDIAN_JSON="$HOME/.var/app/md.obsidian.Obsidian/config/obsidian/obsidian.json"

    flatpak info md.obsidian.Obsidian &>/dev/null || {
        echo "Obsidian Flatpak not installed. Run 'sjust flatpaks' first."
        exit 1
    }

    pgrep -f "md.obsidian.Obsidian" &>/dev/null && {
        echo "Obsidian is running — close it first so the config change isn't overwritten."
        exit 1
    }

    [[ -f "$OBSIDIAN_JSON" ]] || {
        echo "obsidian.json not found at $OBSIDIAN_JSON — launch Obsidian at least once first."
        exit 1
    }

    python3 -c "import json; fp='$OBSIDIAN_JSON'; data=json.load(open(fp)); data['cli']=True; json.dump(data, open(fp,'w')); print('CLI toggle enabled in obsidian.json')"

    [[ -x "$HOME/.local/bin/obsidian" ]] \
        && echo "Wrapper at ~/.local/bin/obsidian is in place." \
        || echo "Warning: ~/.local/bin/obsidian not found — run 'sjust chezmoi' to deploy dotfiles first."

    echo "Done. Launch Obsidian to activate the socket, then test with: obsidian files"

# Configure Obsidian vault name and path (updates chezmoi data)
obsidian-vault name path:
    #!/usr/bin/env bash
    set -euo pipefail
    ABS_PATH=$(realpath -m "{{path}}")
    DATA_FILE="{{HOME}}/dotfiles/.chezmoidata.yaml"
    mkdir -p "$(dirname "$DATA_FILE")"
    printf "obsidian:\n  vault_name: \"{{name}}\"\n  vault_path: \"$ABS_PATH\"\n" > "$DATA_FILE"
    echo "Updated Obsidian vault configuration in $DATA_FILE"
    echo "Vault Name: {{name}}"
    echo "Vault Path: $ABS_PATH"
    echo "Applying changes..."
    chezmoi apply --force

# Download mechvibes soundpacks and install patched nk-cream config (not in setup)
wayvibes-soundpacks:
    #!/usr/bin/env bash
    set -euo pipefail
    DEST="$HOME/wayvibes/soundpacks"
    WORK=$(mktemp -d)
    trap "rm -rf '$WORK'" EXIT

    command -v wayvibes &>/dev/null || { echo "wayvibes not found — is the image up to date?"; exit 1; }

    echo "Cloning mechvibes audio packs..."
    git clone --depth=1 --filter=blob:none --sparse https://github.com/hainguyents13/mechvibes.git "$WORK/mechvibes"
    git -C "$WORK/mechvibes" sparse-checkout set src/audio

    mkdir -p "$DEST"
    cp -r "$WORK/mechvibes/src/audio/." "$DEST/"

    # Replace nk-cream config.json with our patched version.
    # The patch adds keycodes 125 and 139, which are what keyd emits for
    # capslock and the ThinkPad start button (both remapped keys).
    cp {{SHARE}}/wayvibes/nk-cream-config.json "$DEST/nk-cream/config.json"

    echo "Done — soundpacks installed to $DEST"

# Set up arch-box (Stremio + RustDesk) distrobox with app exports
distroboxes:
    #!/usr/bin/env bash
    set -euo pipefail
    trap 'echo ""; echo "FAILED at line $LINENO: $BASH_COMMAND"; exit 1' ERR

    echo "=== arch-box (Stremio + RustDesk) ==="
    distrobox rm --force --yes arch-box 2>/dev/null || true
    rm -f "$HOME/.local/share/applications/"*stremio* 2>/dev/null || true
    rm -f "$HOME/.local/share/applications/"*rustdesk* 2>/dev/null || true
    rm -f "$HOME/.local/bin/"*stremio* 2>/dev/null || true
    rm -f "$HOME/.local/bin/"*rustdesk* 2>/dev/null || true
    rm -rf "$HOME/.config/stremio-enhanced" 2>/dev/null || true

    distrobox create --name arch-box --image archlinux:latest --yes
    distrobox enter --no-tty --name arch-box -- bash -c '
      set -euo pipefail
      sudo pacman -Syu --noconfirm
      sudo pacman -S --noconfirm base-devel git
      cd /tmp && rm -rf yay-bin
      git clone https://aur.archlinux.org/yay-bin.git && cd yay-bin && makepkg -si --noconfirm
    '
    distrobox enter --no-tty --name arch-box -- bash -c '
      set -euo pipefail
      yay -S --noconfirm stremio-enhanced-bin rustdesk-bin ffmpeg gst-plugins-good gst-plugins-bad gst-plugins-ugly gst-libav
    '
    mkdir -p "$HOME/.config/stremio-enhanced/streamingserver"
    stremio_ver=$(curl -sL https://raw.githubusercontent.com/Stremio/stremio-service/refs/heads/master/Cargo.toml | sed -n '/\[package\.metadata\.server\]/,/\[.*\]/p' | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' || echo "v4.21.1")
    wget -O "$HOME/.config/stremio-enhanced/streamingserver/server.js" "https://dl.strem.io/server/${stremio_ver}/desktop/server.js"
    echo -n "$stremio_ver" > "$HOME/.config/stremio-enhanced/streamingserver/version.txt"
    distrobox enter --no-tty --name arch-box -- distrobox-export --app stremio-enhanced
    distrobox enter --no-tty --name arch-box -- distrobox-export --app rustdesk
    mkdir -p "$HOME/.config/systemd/user"
    printf '%s\n' \
      '[Unit]' \
      'Description=RustDesk remote desktop (arch-box)' \
      'After=network.target' \
      '' \
      '[Service]' \
      'ExecStart=distrobox enter --no-tty --name arch-box -- rustdesk --service' \
      'Restart=on-failure' \
      '' \
      '[Install]' \
      'WantedBy=default.target' \
      > "$HOME/.config/systemd/user/rustdesk.service"
    systemctl --user daemon-reload
    systemctl --user enable --now rustdesk
    echo "arch-box done."

# Update the isolated coding agent sandbox container (in-container brew/npm upgrade by default; full rebuild with full=true)
pi-safe full="false":
    #!/usr/bin/env bash
    set -euo pipefail
    CONTAINERFILE="$HOME/dotfiles/dot_pi/Containerfile"
    if [[ ! -f "$CONTAINERFILE" ]]; then
        echo -e "\033[31mpi-safe Containerfile not found at $CONTAINERFILE\033[0m"
        exit 1
    fi

    IS_FULL="false"
    case "{{full}}" in
        true|1|full|full=true|--full|--full-rebuild|rebuild|rebuild=true) IS_FULL="true" ;;
    esac

    if [[ "$IS_FULL" == "true" ]] || ! podman image exists localhost/pi-safe:latest; then
        echo -e "\033[36mRunning full clean rebuild of localhost/pi-safe:latest (--no-cache)...\033[0m"
        podman build --no-cache -t localhost/pi-safe:latest -f "$CONTAINERFILE" "$HOME/dotfiles"
        echo -e "\033[32mlocalhost/pi-safe:latest full rebuild complete.\033[0m"
        exit 0
    fi

    # Fast update path (default):
    # 1. Catch any Containerfile or dot_Brewfile-container changes (uses layer cache, fast if unchanged)
    echo -e "\033[36mChecking Containerfile layer cache for localhost/pi-safe:latest...\033[0m"
    podman build -t localhost/pi-safe:latest -f "$CONTAINERFILE" "$HOME/dotfiles"

    # 2. In-container upgrade: update Linuxbrew formulae and upgrade pi-coding-agent, uv, etc.
    echo -e "\033[36mUpgrading in-container Linuxbrew packages (pi-coding-agent, uv, etc.)...\033[0m"
    UPGRADE_CTR="pi-safe-upgrade-$$"
    podman run --name "$UPGRADE_CTR" --entrypoint bash localhost/pi-safe:latest -c '
        brew update && brew upgrade && brew cleanup
        npm update -g 2>/dev/null || true
    '
    podman commit "$UPGRADE_CTR" localhost/pi-safe:latest >/dev/null
    podman rm "$UPGRADE_CTR" >/dev/null
    echo -e "\033[32mlocalhost/pi-safe:latest update complete.\033[0m"

# Check and compile bleeding-edge GPU LLM engines (Nathan, Laurent, Gaetan,
# plus halo-box Vulkan and ROCm/HIP variants).
llm-engines force="false":
    #!/usr/bin/env bash
    set -euo pipefail
    IS_FORCE="false"
    case "{{force}}" in
        true|1|force|force=true|--force) IS_FORCE="true" ;;
    esac

    if ! podman container exists lemonade; then
        echo -e "\033[33mLemonade container not found, skipping GPU engine update.\033[0m"
        exit 0
    fi
    ENGINE_SCRIPT="{{HOME}}/turquoise/files/system/usr/share/turquoise/llm-ubuntu26-build-engines.sh"
    [[ -x "$ENGINE_SCRIPT" ]] || ENGINE_SCRIPT="{{SHARE}}/llm-ubuntu26-build-engines.sh"
    [[ -x "$ENGINE_SCRIPT" ]] || {
        echo -e "\033[31mLLM engine builder not found: $ENGINE_SCRIPT\033[0m"
        exit 1
    }

    # Attempt to gracefully unload model if loaded before rebuilding/swapping
    if curl -fsS --max-time 3 http://127.0.0.1:13305/api/v1/health 2>/dev/null | \
        python3 -c 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if (d.get("model_loaded") or d.get("all_models_loaded")) else 1)' 2>/dev/null; then
        echo -e "\033[33m  Lemonade has a model loaded; sending unload request...\033[0m"
        curl -fsS -X POST http://127.0.0.1:13305/api/v1/unload 2>/dev/null || true
        sleep 2
    fi

    echo -e "\033[36mChecking bleeding-edge GPU LLM engines from upstream GitHub repos (FORCE=$IS_FORCE)...\033[0m"
    VOLUME=lemonade26-llama \
    JOBS="${LLM_BUILD_JOBS:-64}" \
    FORCE="$IS_FORCE" \
    ONLY=all \
    "$ENGINE_SCRIPT"

    WRAPPER_SRC="{{HOME}}/turquoise/files/system/usr/share/turquoise/llama-dispatch-wrapper.sh"
    [[ -f "$WRAPPER_SRC" ]] || WRAPPER_SRC="{{SHARE}}/llama-dispatch-wrapper.sh"
    if [[ -f "$WRAPPER_SRC" ]]; then
        echo -e "\033[36mSynchronizing and validating the five-engine dispatch wrapper...\033[0m"
        podman cp "$WRAPPER_SRC" lemonade:/opt/lemonade/llama/llama-server
        podman cp "$WRAPPER_SRC" lemonade:/opt/lemonade/llama/vulkan/bin/llama-server
        podman cp "$WRAPPER_SRC" lemonade:/root/.cache/lemonade/bin/llamacpp/vulkan/llama-server
        podman exec lemonade chmod +x \
            /opt/lemonade/llama/llama-server \
            /opt/lemonade/llama/vulkan/bin/llama-server \
            /root/.cache/lemonade/bin/llamacpp/vulkan/llama-server
        podman exec lemonade bash -euc '
            for f in /opt/lemonade/llama/llama-server /opt/lemonade/llama/vulkan/bin/llama-server /root/.cache/lemonade/bin/llamacpp/vulkan/llama-server; do
                test -x "$f"
                grep -q -- force-rocm "$f"
                grep -q -- force-laurent "$f"
                grep -q -- force-halo-vulkan "$f"
                grep -q -- force-halo-rocm "$f"
            done
            test -x /opt/lemonade/llama/halo-vulkan/bin/llama-server-real
            test -x /opt/lemonade/llama/halo-rocm/llama-server
            halo_commit=$(sed -n "s/^commit=//p" /opt/lemonade/llama/halo-vulkan/BUILD-INFO | head -1)
            test -n "$halo_commit"
            halo_short=${halo_commit:0:7}
            check_halo_wrapper() {
                local wrapper="$1" version help
                version=$("$wrapper" --force-vulkan --force-halo-vulkan --version 2>&1)
                grep -q "commit $halo_short" <<<"$version"
                version=$("$wrapper" --force-halo-vulkan --force-vulkan --version 2>&1)
                grep -q "commit $halo_short" <<<"$version"
                help=$("$wrapper" --force-vulkan --force-halo-vulkan --help 2>&1)
                grep -q -- "--ngram-on-disk" <<<"$help"
            }
            for wrapper in /opt/lemonade/llama/llama-server /opt/lemonade/llama/vulkan/bin/llama-server /root/.cache/lemonade/bin/llamacpp/vulkan/llama-server; do
                check_halo_wrapper "$wrapper"
            done
        '
    fi

    podman restart lemonade
    for _ in {1..30}; do
        if curl -fsS --max-time 5 http://127.0.0.1:13305/api/v1/health 2>/dev/null | \
            python3 -c 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if d.get("status")=="ok" and d.get("version")=="10.8.0" and d.get("model_loaded") is None else 1)' 2>/dev/null; then
            echo -e "\033[32mLemonade restart and health check passed.\033[0m"
            break
        fi
        sleep 2
    done

# Short singular alias for the engine refresh command.
llm-engine force="false":
    just --justfile "{{justfile()}}" llm-engines "{{force}}"

# System maintenance: health check, image upgrade, flatpaks, brew, distroboxes, firmware (not in setup)
# Options:
#   sjust update              # Full update, checking bleeding-edge LLM engine commits & updating pi container
#   sjust update quick=true   # Fast update, skipping LLM engine and container rebuilds
#   sjust update force=true   # Force full recompile of all current LLM engines
update quick="false" force="false":
    #!/usr/bin/env bash
    set -euo pipefail
    IS_QUICK="false"
    IS_FORCE="false"
    for arg in "{{quick}}" "{{force}}"; do
        case "$arg" in
            quick|quick=true|true) IS_QUICK="true" ;;
            force|force=true) IS_FORCE="true" ;;
        esac
    done
    echo -e "\033[33mNOTE: uupd handles image, flatpaks, homebrew, and distroboxes automatically daily at 4am.\033[0m"

    echo -e "\n\033[34m=== System Health Check ===\033[0m"
    echo -e "\033[36m  \$ systemctl --failed\033[0m"
    systemctl --failed || true

    echo -e "\n\033[34m=== Empty Trash? ===\033[0m"
    if command -v trash-empty >/dev/null; then
        trash-empty
    else
        gio trash --empty || true
    fi

    echo -e "\n\033[34m=== Staging Image Update (bootc upgrade) ===\033[0m"
    echo -e "\033[36m  \$ sudo bootc upgrade\033[0m"
    sudo bootc upgrade

    echo -e "\n\033[34m=== Updating Flatpaks ===\033[0m"
    echo -e "\033[36m  \$ flatpak update -y\033[0m"
    flatpak update -y || true

    echo -e "\n\033[34m=== Removing Unused Flatpak Runtimes ===\033[0m"
    echo -e "\033[36m  \$ flatpak uninstall --unused -y\033[0m"
    flatpak uninstall --unused -y || true

    echo -e "\n\033[34m=== Updating Distroboxes ===\033[0m"
    if command -v distrobox >/dev/null; then
        echo -e "\033[36m  \$ distrobox upgrade --all\033[0m"
        distrobox upgrade --all || true
        if distrobox list 2>/dev/null | grep -q arch-box; then
            echo -e "\033[36m  Syncing Stremio server.js for arch-box...\033[0m"
            mkdir -p "$HOME/.config/stremio-enhanced/streamingserver"
            stremio_ver=$(curl -sL https://raw.githubusercontent.com/Stremio/stremio-service/refs/heads/master/Cargo.toml | sed -n '/\[package\.metadata\.server\]/,/\[.*\]/p' | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' || true)
            if [ -n "$stremio_ver" ]; then
                current_stremio_ver=$(cat "$HOME/.config/stremio-enhanced/streamingserver/version.txt" 2>/dev/null || true)
                if [ "$current_stremio_ver" != "$stremio_ver" ] || [ ! -f "$HOME/.config/stremio-enhanced/streamingserver/server.js" ]; then
                    echo "  Updating Stremio server.js to $stremio_ver..."
                    wget -q -O "$HOME/.config/stremio-enhanced/streamingserver/server.js" "https://dl.strem.io/server/${stremio_ver}/desktop/server.js" || true
                    echo -n "$stremio_ver" > "$HOME/.config/stremio-enhanced/streamingserver/version.txt"
                fi
            fi
        fi
    else
        echo -e "\033[31m  Distrobox not found, skipping.\033[0m"
    fi

    echo -e "\n\033[34m=== Updating MCP Servers (uv tools) ===\033[0m"
    if command -v uv >/dev/null; then
        echo -e "\033[36m  Syncing uv tools from ~/.Uvfile...\033[0m"
        just --justfile "{{justfile()}}" uv
    fi

    if command -v turbovault >/dev/null; then
        echo -e "\033[36m  Checking TurboVault updates...\033[0m"
        latest_tag=$(curl -s --connect-timeout 5 https://api.github.com/repos/Epistates/turbovault/releases/latest | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/' || true)
        current_ver=$(turbovault --version 2>/dev/null | awk '{print $2}' || true)
        if [[ -n "$latest_tag" && "v${current_ver}" != "$latest_tag" && "$current_ver" != "$latest_tag" ]]; then
            echo -e "\033[33m  Rebuilding TurboVault (sql) from ${current_ver:-unknown} to ${latest_tag}...\033[0m"
            SRC_TV="$HOME/.local/src/turbovault"
            if [[ -d "$SRC_TV/.git" ]]; then
                git -C "$SRC_TV" fetch --tags --quiet
                if git -C "$SRC_TV" checkout --quiet "$latest_tag" 2>/dev/null; then
                    if bash "$HOME/.local/bin/tv-fix-tool-schemas" "$SRC_TV"; then
                        if podman run --rm \
                            -v "$SRC_TV":/src:z \
                            -v tv-cargo-cache:/usr/local/cargo \
                            -w /src \
                            rust:1.90-bookworm \
                            bash -c 'export DEBIAN_FRONTEND=noninteractive; apt-get update -qq >/dev/null 2>&1; apt-get install -y -qq cmake libssl-dev pkg-config build-essential >/dev/null 2>&1; cargo build --release --features sql'; then
                            install -m755 "$SRC_TV/target/release/turbovault" "$HOME/.local/bin/turbovault"
                            echo -e "\033[32m  Host turbovault rebuilt (sql) to ${latest_tag}.\033[0m"
                        else
                            echo -e "\033[31m  Build failed; keeping previous turbovault.\033[0m"
                        fi
                    else
                        echo -e "\033[33m  Schema patch could not be applied; skipping rebuild to avoid shipping an unpatched binary.\033[0m"
                    fi
                else
                    echo -e "\033[33m  Checkout of ${latest_tag} failed, skipping.\033[0m"
                fi
            else
                echo -e "\033[33m  Skipping: no checkout at ~/.local/src/turbovault (clone: git clone https://github.com/Epistates/turbovault ~/.local/src/turbovault)\033[0m"
            fi
        else
            echo -e "  TurboVault is up to date (${current_ver:-1.6.0})."
        fi
    fi

    if command -v turbovault-http >/dev/null; then
        echo -e "\033[36m  Checking TurboVault (http build) updates...\033[0m"
        latest_tag=$(curl -s --connect-timeout 5 https://api.github.com/repos/Epistates/turbovault/releases/latest | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/' || true)
        current_ver=$(turbovault-http --version 2>/dev/null | awk '{print $2}' || true)
        if [[ -n "$latest_tag" && "v${current_ver}" != "$latest_tag" && "$current_ver" != "$latest_tag" ]]; then
            echo -e "\033[33m  Rebuilding TurboVault-http (${current_ver:-unknown} -> ${latest_tag})...\033[0m"
            SRC_TV="$HOME/.local/src/turbovault"
            if [[ -d "$SRC_TV/.git" ]]; then
                git -C "$SRC_TV" fetch --tags --quiet
                if git -C "$SRC_TV" checkout --quiet "$latest_tag" 2>/dev/null; then
                    if bash "$HOME/.local/bin/tv-fix-tool-schemas" "$SRC_TV"; then
                        if podman run --rm \
                            -v "$SRC_TV":/src:z \
                            -v tv-cargo-cache:/usr/local/cargo \
                            -w /src \
                            rust:1.90-bookworm \
                            bash -c 'export DEBIAN_FRONTEND=noninteractive; apt-get update -qq >/dev/null 2>&1; apt-get install -y -qq cmake libssl-dev pkg-config build-essential >/dev/null 2>&1; cargo build --release --features http,sql'; then
                            install -m755 "$SRC_TV/target/release/turbovault" "$HOME/.local/bin/turbovault-http"
                            systemctl --user restart turbovault-web-ro turbovault-web-full 2>/dev/null || true
                            echo -e "\033[32m  turbovault-http rebuilt to ${latest_tag}.\033[0m"
                        else
                            echo -e "\033[31m  Build failed; keeping previous turbovault-http.\033[0m"
                        fi
                    else
                        echo -e "\033[33m  Schema patch could not be applied; skipping rebuild to avoid shipping an unpatched binary.\033[0m"
                    fi
                else
                    echo -e "\033[33m  Checkout of ${latest_tag} failed, skipping.\033[0m"
                fi
            else
                echo -e "\033[33m  Skipping: no checkout at ~/.local/src/turbovault (clone: git clone https://github.com/Epistates/turbovault ~/.local/src/turbovault)\033[0m"
            fi
        else
            echo -e "  TurboVault-http is up to date (${current_ver:-1.6.0})."
        fi
    fi

    if [[ -f "$HOME/.agents/mcp/searxng/venv/bin/pip" ]]; then
        echo -e "\033[36m  Updating SearxNG MCP virtualenv dependencies...\033[0m"
        "$HOME/.agents/mcp/searxng/venv/bin/pip" install --upgrade -q mcp requests 2>/dev/null || true
    fi

    if [[ -x "{{HOME}}/.local/bin/zotero-mcp-server" ]]; then
        systemctl --user restart zotero-mcp.service 2>/dev/null || true
        echo -e "  \033[32mZotero MCP fork installed; service restarted.\033[0m"
    fi

    if [[ "$IS_QUICK" != "true" ]]; then
        echo -e "\n\033[34m=== Updating pi-safe Container ===\033[0m"
        just --justfile "{{justfile()}}" pi-safe "$IS_FORCE"

        echo -e "\n\033[34m=== Updating GPU LLM Engines in Lemonade ===\033[0m"
        just --justfile "{{justfile()}}" llm-engines "$IS_FORCE"
    else
        echo -e "\n\033[33m=== Skipping container and LLM engine builds (quick mode) ===\033[0m"
    fi

    echo -e "\n\033[34m=== Updating Homebrew and Packages ===\033[0m"
    if command -v brew >/dev/null; then
        sudo chown -R "$(whoami):wheel" /home/linuxbrew 2>/dev/null || true
        sudo chmod -R g+rwX /home/linuxbrew 2>/dev/null || true
        echo -e "\033[36m  \$ brew update && brew upgrade && brew cleanup\033[0m"
        brew update && brew upgrade && brew cleanup
    else
        echo -e "\033[31m  Homebrew not found, skipping.\033[0m"
    fi

    echo -e "\n\033[34m=== Updating pipx Packages ===\033[0m"
    if command -v pipx >/dev/null; then
        just --justfile "{{justfile()}}" pipx
    else
        echo -e "\033[31m  pipx not found, skipping.\033[0m"
    fi

    echo -e "\n\033[34m=== Updating npm Global Packages ===\033[0m"
    if command -v npm >/dev/null; then
        just --justfile "{{justfile()}}" npm
    else
        echo -e "\033[31m  npm not found, skipping.\033[0m"
    fi

    echo -e "\n\033[34m=== Checking Firmware Updates ===\033[0m"
    fwupdmgr refresh && fwupdmgr get-updates || true

    echo -e "\n\033[32mUpdate sequence complete!\033[0m"

# Fix Btrfs transparent compression on composefs (Fedora 42+ / Bluefin 44+)
fix-compression:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Applying Btrfs zstd compression workaround..."

    # 1. Update kernel args if not already present
    if rpm-ostree kargs | grep -q "compress=zstd"; then
        echo "  Kernel arguments already updated."
    else
        echo "  Adding compress=zstd:1 to kernel arguments..."
        cur=$(rpm-ostree kargs | grep -o 'rootflags=[^ ]*' || true)
        if [ -n "$cur" ]; then
            sudo rpm-ostree kargs --delete="$cur" --append="${cur},compress=zstd:1"
        else
            sudo rpm-ostree kargs --append=rootflags=subvol=root,compress=zstd:1
        fi
    fi

    # 2. Comment out root mount in /etc/fstab if not already commented
    if grep -E '^[^\#].*\s+/\s+btrfs' /etc/fstab >/dev/null; then
        echo "  Commenting out root mount in /etc/fstab..."
        sudo sed -i.bak 's/^\([^#].*\s\+\/\s\+btrfs\)/# \1/' /etc/fstab
        echo "  /etc/fstab updated (backup saved as /etc/fstab.bak)."
    else
        echo "  Root mount in /etc/fstab is already commented out."
    fi

    echo "Workaround applied. Please reboot your system to activate compression."

# ── HP ZBook Ultra G1a (Strix Halo) — turquoise-halo only ────────────────────
# Everything the turquoise-halo image can't/shouldn't bake: per-machine post-
# install (compression, groups, amd-debug-tools), verification of baked features,
# and the NPU kernel-arg toggle. Hardware notes:
#   ~/Dropbox/.../Custom Image/HP ZBook Ultra G1a 14'' Ryzen AI Max+ 395.md
#   ~/Dropbox/.../Local LLMs/Strix Halo LLM Guide.md
# Guarded by /usr/share/turquoise/image-id so they no-op on the P14s.

# Strix Halo post-install: compression, groups, suspend tools, then verify (turquoise-halo only)
halo:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "$(cat /usr/share/turquoise/image-id 2>/dev/null)" != "turquoise-halo" ]]; then
        echo -e "\033[31mThis recipe is for the turquoise-halo image (HP ZBook Ultra G1a) only.\033[0m"
        echo "  Current image-id: $(cat /usr/share/turquoise/image-id 2>/dev/null || echo unknown)"
        exit 1
    fi

    echo -e "\033[34m=== 1/4 Groups + shell (sjust system) ===\033[0m"
    sjust system

    echo -e "\n\033[34m=== 2/4 Btrfs compression workaround (sjust fix-compression) ===\033[0m"
    sjust fix-compression

    echo -e "\n\033[34m=== 3/4 Suspend debug tools (amd-debug-tools → amd-s2idle) ===\033[0m"
    # Not packaged for Fedora — superm1's upstream pipx tool. Provides `amd-s2idle`.
    if command -v pipx >/dev/null && pipx list --short 2>/dev/null | grep -q '^amd-debug-tools'; then
        echo "  amd-debug-tools already installed."
    elif command -v pipx >/dev/null; then
        echo "  Installing amd-debug-tools via pipx..."
        pipx install amd-debug-tools || echo -e "  \033[33mInstall failed — run 'sjust pipx' / check network.\033[0m"
    else
        echo -e "  \033[33mpipx not found — run 'sjust pipx' first.\033[0m"
    fi

    echo -e "\n\033[34m=== 4/4 Verifying baked hardware enablement ===\033[0m"
    sjust halo-verify || true

    echo -e "\n\033[41;97m  MANUAL STEPS — NOT done by this script. You must do these yourself.  \033[0m"
    echo -e "\033[33m  (firmware/install-time settings; no software, including sjust, can apply them)\033[0m"
    echo ""
    echo -e "\033[36m  ▶ BIOS/UEFI — enter setup at boot and set each of these by hand:\033[0m"
    echo "      [ ] Secure Boot ............................ DISABLED  (required for the vanilla kernel)"
    echo "      [ ] Pluton ................................. ENABLED   (s2idle suspend breaks if disabled)"
    echo "      [ ] Integrated Graphics UMA Frame Buffer ... 512 MB    (not Auto/large)"
    echo "      [ ] Fan offset ............................. +2        (steady low spin instead of cycling)"
    echo "      [ ] ASPM ................................... default   (do not force off)"
    echo -e "\033[36m  ▶ Install-time (only relevant on a fresh install — already chosen at Anaconda):\033[0m"
    echo "      [ ] Btrfs + LUKS full-disk encryption"
    echo -e "\033[33m  None of the above are verified by 'sjust halo-verify' — they are firmware-only.\033[0m"
    echo ""
    echo -e "\033[36m  ▶ Now: REBOOT\033[0m to activate the compression workaround + any karg changes."
    echo -e "\n\033[32mhalo setup complete (automated steps).\033[0m Manual BIOS steps above are still up to you."

# Verify turquoise-halo baked features: kargs, webcam, sched-ext, NPU, suspend (read-only)
halo-verify:
    #!/usr/bin/env bash
    set -uo pipefail
    pass() { echo -e "  \033[32m✓\033[0m $*"; }
    warn() { echo -e "  \033[33m!\033[0m $*"; }
    fail() { echo -e "  \033[31m✗\033[0m $*"; }

    if [[ "$(cat /usr/share/turquoise/image-id 2>/dev/null)" != "turquoise-halo" ]]; then
        warn "image-id is not turquoise-halo — these checks assume the Halo image."
    fi

    echo -e "\033[34mKernel arguments (baked via kargs module)\033[0m"
    KARGS="$(rpm-ostree kargs 2>/dev/null || true)"
    for arg in amd_pstate=active ttm.pages_limit=32505856 amd_iommu=off; do
        grep -q -- "$arg" <<<"$KARGS" && pass "$arg" || fail "$arg MISSING"
    done
    grep -q 'compress=zstd' <<<"$KARGS" && pass "compress=zstd in kargs" \
        || warn "compress=zstd not in kargs — run 'sjust fix-compression' + reboot"

    echo -e "\033[34mBtrfs compression (journal)\033[0m"
    if journalctl -k -g 'use zstd compression' 2>/dev/null | grep -q zstd; then
        pass "btrfs zstd compression active"
    else
        warn "no 'use zstd compression' in kernel log (reboot after fix-compression, or check perms)"
    fi

    echo -e "\033[34mWebcam — AMD ISP4 kmod (built at image time)\033[0m"
    if [[ -d /sys/module/amd_isp4_capture ]] || (command -v lsmod >/dev/null && lsmod | grep -q amd_isp4_capture); then
        pass "amd_isp4_capture loaded"
    else
        warn "amd_isp4_capture not loaded"
    fi
    if command -v v4l2-ctl >/dev/null; then
        v4l2-ctl --list-devices 2>/dev/null | grep -qi isp && pass "ISP4 video device present" \
            || warn "no ISP4 device in v4l2-ctl --list-devices"
    fi

    echo -e "\033[34msched-ext schedulers\033[0m"
    systemctl is-enabled scx_loader.service &>/dev/null && pass "scx_loader.service enabled" || fail "scx_loader.service not enabled"
    SCX="$(scxctl get 2>/dev/null || sudo -n scxctl get 2>/dev/null || true)"
    [[ -n "$SCX" ]] && pass "active scheduler: $SCX" || warn "scxctl get returned nothing (try: sudo scxctl get)"

    echo -e "\033[34mAC-wakeup suspend fix\033[0m"
    systemctl is-enabled ac-wakeup-disable.service &>/dev/null && pass "ac-wakeup-disable.service enabled" || fail "ac-wakeup-disable.service not enabled"

    echo -e "\033[34mKeyboard suspend wakeup fix\033[0m"
    if [[ -f /sys/bus/serio/devices/serio0/power/wakeup ]]; then
        WAKE_STATE="$(cat /sys/bus/serio/devices/serio0/power/wakeup 2>/dev/null || true)"
        if [[ "$WAKE_STATE" == "disabled" ]]; then
            pass "serio0 keyboard wakeup disabled"
        else
            warn "serio0 keyboard wakeup is $WAKE_STATE (should be disabled via udev)"
        fi
    else
        warn "serio0 keyboard wakeup file not found"
    fi

    echo -e "\033[34miGPU memory (GTT)\033[0m"
    if journalctl -k -g 'GTT memory' 2>/dev/null | grep -qi 'GTT memory'; then
        pass "$(journalctl -k -g 'GTT memory' 2>/dev/null | tail -1 | sed 's/.*]: *//')"
    else
        warn "no 'GTT memory' line in kernel log (check perms or reboot)"
    fi

    echo -e "\033[34mNPU Status (XDNA2 / amdxdna)\033[0m"
    if grep -q -- "amd_iommu=off" <<<"$KARGS"; then
        pass "NPU disabled via amd_iommu=off (allocating full memory bandwidth to Radeon 8060S iGPU)"
    elif [[ -e /dev/accel/accel0 ]]; then
        pass "/dev/accel/accel0 present"
    else
        warn "/dev/accel/accel0 absent"
    fi

    echo -e "\033[34mSuspend test tooling\033[0m"
    command -v amd-s2idle >/dev/null && pass "amd-s2idle available — run 'sudo amd-s2idle test' to validate s2idle" \
        || warn "amd-s2idle not installed — run 'sjust halo' or 'pipx install amd-debug-tools'"

