            already) echo -e "  Already patched." ;;
            mismatch*) echo -e "  \033[33mWARNING: hybrid patch pattern changed upstream; not applied — review manually.\033[0m" ;;
            *) echo -e "  \033[33mHybrid patch failed; review manually.\033[0m" ;;
        esac
    fi

    # zotero-mcp-server: re-apply the Qwen3-Embedding query-instruct patch (idempotent).
    # Prepends `Instruct: <task>\nQuery: <query>` on the QUERY side only in
    # OpenAIEmbeddingFunction.embed_query (documents stay raw via __call__);
    # Qwen3-Embedding official guidance: omitting it costs ~1-5% retrieval.
    # Marker: [instruct patch]. See Zotero-MCP.md.
    echo -e "\033[36m  Re-applying zotero-mcp query-instruct patch...\033[0m"
    ZMPKG=$(find "$HOME/.local/share/uv/tools/zotero-mcp-server/lib" -type d -name zotero_mcp 2>/dev/null | head -1)
    ZIPATCH=/usr/share/turquoise/zotero-mcp-instruct-patch.py
    [[ -f "$ZIPATCH" ]] || ZIPATCH="$HOME/turquoise/files/system/usr/share/turquoise/zotero-mcp-instruct-patch.py"
